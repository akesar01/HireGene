# Prod: Supabase session pooler (port 5432), no pgbouncer=true. See "Region and database connection" in DEPLOYMENT.md.
DATABASE_URL="postgresql://user:password@host:5432/db?sslmode=require&connection_limit=5"
APIFY_TOKEN="your_apify_token"
APIFY_MAX_CONCURRENT="5"
ADMIN_SECRET="your_admin_secret"
CRON_SECRET="your_cron_secret"
API_KEY="your_api_key"
CORS_ORIGIN="http://localhost:3000"
GROQ_API_KEY="your_groq_api_key"
GROQ_MODEL="openai/gpt-oss-120b"
