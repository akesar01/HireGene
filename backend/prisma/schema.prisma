// This is your Prisma schema file.
// Learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge function?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ═══════════════════════════════════════════════════════════════════════════════
// ENUMS
// ═══════════════════════════════════════════════════════════════════════════════

enum JobSource {
  linkedin
  x
}

enum RoleFamily {
  engineering
  ai_ml
  product
  design
  data
  growth
  marketing
  content
  ops
  founders_office
  sales
  strategy
  finance
  business
  people
}

enum SeniorityLevel {
  intern
  junior
  mid
  senior
  lead
  staff
  head
}

enum RemoteMode {
  in_office
  remote
  hybrid
}

enum TechStack {
  python
  java
  sql
  ai
  aws
  langchain
  rag
  react
  llm
  nextjs
  typescript
  nodejs
  go
  rust
  docker
}

// ═══════════════════════════════════════════════════════════════════════════════
// RECRUITER MODEL
// ═══════════════════════════════════════════════════════════════════════════════

model Recruiter {
  id                 Int      @id @default(autoincrement())
  name               String
  linkedinUrl        String   @unique @map("linkedin_url")
  active             Boolean  @default(true)

  // Cadence used by /api/cron/scrape to decide if a recruiter is due.
  scrapeIntervalHours Int     @default(24) @map("scrape_interval_hours")

  addedAt            DateTime  @default(now()) @map("added_at")
  lastScrapedAt      DateTime? @map("last_scraped_at")

  // Relations
  jobs               Job[]
  apifyRuns          ApifyRunLog[]

  @@index([active, lastScrapedAt]) // cron due-query + list endpoint filtering
  @@map("recruiters")
}

// ═══════════════════════════════════════════════════════════════════════════════
// RECRUITER SUBMISSION MODEL (human-in-the-loop review)
// ═══════════════════════════════════════════════════════════════════════════════

enum SubmissionStatus {
  pending
  approved
  rejected
}

model RecruiterSubmission {
  id              Int              @id @default(autoincrement())
  name            String
  linkedinUrl     String           @map("linkedin_url")
  company         String?
  title           String?          // e.g. "Engineering Manager @ Google"
  note            String?          // optional context from submitter
  submittedByIp   String?          @map("submitted_by_ip")
  status          SubmissionStatus @default(pending)
  reviewedAt      DateTime?        @map("reviewed_at")
  recruiterId     Int?             @map("recruiter_id") // set when approved
  createdAt       DateTime         @default(now()) @map("created_at")

  @@index([status])
  @@index([linkedinUrl])
  @@map("recruiter_submissions")
}

// ═══════════════════════════════════════════════════════════════════════════════
// JOB MODEL
// ═══════════════════════════════════════════════════════════════════════════════

model Job {
  id            Int      @id @default(autoincrement())

  // Foreign key
  recruiterId   Int      @map("recruiter_id")
  recruiter     Recruiter @relation(fields: [recruiterId], references: [id], onDelete: Cascade)
  votes         Vote[]
  applications  JobApplication[]

  // Core fields
  title         String
  company       String
  author        String
  authorTitle   String   @map("author_title")
  authorAvatar  String?  @map("author_avatar")
  roleBadge     String   @map("role_badge")

  // Source
  source        JobSource
  sourceUrl     String   @unique @map("source_url") // idempotent dedup key

  // True if the recruiter shared/reposted someone else's post.
  // author still = the recruiter (per product decision), this just flags it.
  isRepost      Boolean  @default(false) @map("is_repost")

  // Structured attributes
  roleFamily    RoleFamily @map("role_family")
  seniority     SeniorityLevel
  remoteMode    RemoteMode @map("remote_mode")
  stack         TechStack[]

  // Content
  description   String[]
  rawText       String   @map("raw_text") // original post text; enables future LLM re-parse

  // Hash of rawText. On re-scrape, if the URL exists but the hash differs,
  // the post was edited -> we can UPDATE instead of skipping. Cheap edit detection.
  contentHash   String   @map("content_hash")

  // Community engagement
  commentCount  Int      @default(0) @map("comment_count")
  score         Int      @default(0) // net upvotes - downvotes

  // Lifecycle
  postedAt      DateTime @map("posted_at")
  expiresAt     DateTime @map("expires_at")
  createdAt     DateTime @default(now()) @map("created_at")

  // Indexes
  @@index([expiresAt])
  @@index([source, roleFamily, seniority, remoteMode])
  @@index([commentCount(sort: Desc)])
  @@index([score(sort: Desc)])
  @@index([postedAt(sort: Desc)])
  @@index([recruiterId])

  @@map("jobs")
}

// ═══════════════════════════════════════════════════════════════════════════════
// VOTE MODEL (IP-based dedup, one vote per IP per job)
// ═══════════════════════════════════════════════════════════════════════════════

model Vote {
  id        Int      @id @default(autoincrement())
  jobId     Int      @map("job_id")
  job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  voterIp   String   @map("voter_ip")
  direction String   // "up" | "down"
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([jobId, voterIp])
  @@index([jobId])
  @@map("votes")
}

// ═══════════════════════════════════════════════════════════════════════════════
// APIFY RUN LOG MODEL
// ═══════════════════════════════════════════════════════════════════════════════

model ApifyRunLog {
  id            Int      @id @default(autoincrement())
  recruiterId   Int?     @map("recruiter_id")
  recruiter     Recruiter? @relation(fields: [recruiterId], references: [id], onDelete: SetNull)

  apifyRunId    String   @unique @map("apify_run_id")
  actorId       String   @map("actor_id")
  source        JobSource

  status        String   // "RUNNING" | "SUCCEEDED" | "FAILED" | "TIMED-OUT"
  postsFound    Int      @default(0) @map("posts_found")
  jobsCreated   Int      @default(0) @map("jobs_created")
  jobsSkipped   Int      @default(0) @map("jobs_skipped")

  startedAt     DateTime @map("started_at")
  finishedAt    DateTime? @map("finished_at")

  errorMsg      String?  @map("error_msg")

  @@map("apify_run_logs")
}

// ═══════════════════════════════════════════════════════════════════════════════
// JOB APPLICATION MODEL (per-user "Applied" tracking, Clerk userId)
// ═══════════════════════════════════════════════════════════════════════════════

model JobApplication {
  id        Int      @id @default(autoincrement())
  jobId     Int      @map("job_id")
  job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  userId    String   @map("user_id")
  appliedAt DateTime @default(now()) @map("applied_at")

  @@unique([jobId, userId])
  @@index([userId])
  @@map("job_applications")
}

// ═══════════════════════════════════════════════════════════════════════════════
// EMAIL NUDGES (match-based job emails to signed-in users)
// ═══════════════════════════════════════════════════════════════════════════════

enum EmailFrequency {
  weekly
  daily
}

// Per-user email preferences. A user with a resume profile and no row is
// treated as subscribed weekly (the privacy page states this default).
model EmailPreference {
  id                 Int            @id @default(autoincrement())
  userId             String         @unique @map("user_id") // Clerk user id
  email              String?        // Clerk primary email, cached at last send
  subscribed         Boolean        @default(true)
  frequency          EmailFrequency @default(weekly)
  pausedUntil        DateTime?      @map("paused_until")
  unsubscribedAt     DateTime?      @map("unsubscribed_at")
  unsubscribeReason  String?        @map("unsubscribe_reason") // user | bounce | complaint | admin
  unsubscribeToken   String         @unique @map("unsubscribe_token")
  lastSentAt         DateTime?      @map("last_sent_at")
  createdAt          DateTime       @default(now()) @map("created_at")
  updatedAt          DateTime       @updatedAt @map("updated_at")

  @@index([subscribed, frequency])
  @@map("email_preferences")
}

enum CampaignKind {
  weekly
  daily
  manual
  experiment
}

enum CampaignStatus {
  draft
  running
  completed
}

model Campaign {
  id          Int            @id @default(autoincrement())
  key         String         @unique // weekly-2026-W40, daily-2026-10-02, manual-<ts>, exp-<slug>
  name        String
  kind        CampaignKind
  status      CampaignStatus @default(draft)
  jobCount    Int            @default(5) @map("job_count")
  createdBy   String?        @map("created_by") // admin user id or "cron"
  startedAt   DateTime?      @map("started_at")
  completedAt DateTime?      @map("completed_at")
  createdAt   DateTime       @default(now()) @map("created_at")

  variants    CampaignVariant[]
  sends       NudgeSend[]

  @@index([status])
  @@map("campaigns")
}

// Experiment arms. Weights are percentages; a holdout arm receives nothing.
model CampaignVariant {
  id         Int      @id @default(autoincrement())
  campaignId Int      @map("campaign_id")
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  key        String   // "A", "B", "control"
  name       String
  weight     Int      // 0-100, all weights in a campaign sum to 100
  isHoldout  Boolean  @default(false) @map("is_holdout")
  subject    String?  // supports {count} {companies} {name}
  intro      String?
  jobCount   Int?     @map("job_count")

  sends      NudgeSend[]

  @@unique([campaignId, key])
  @@map("campaign_variants")
}

enum SendStatus {
  queued     // row written, provider not yet called
  dry_run    // rendered and recorded; no RESEND_API_KEY
  sent       // accepted by the provider
  delivered
  bounced
  complained
  failed
  skipped    // zero qualifying jobs
  holdout    // control arm, nothing sent
}

// One row per recipient per campaign. The id is the public /go/<sendId> key.
model NudgeSend {
  id                String          @id // app-generated UUID
  campaignId        Int             @map("campaign_id")
  campaign          Campaign        @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  variantId         Int?            @map("variant_id")
  variant           CampaignVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  userId            String          @map("user_id")
  email             String
  status            SendStatus
  providerMessageId String?         @unique @map("provider_message_id")
  jobIds            Int[]           @map("job_ids")
  subject           String?
  error             String?
  sentAt            DateTime?       @map("sent_at")
  deliveredAt       DateTime?       @map("delivered_at")
  openedAt          DateTime?       @map("opened_at")
  clickedAt         DateTime?       @map("clicked_at")
  bouncedAt         DateTime?       @map("bounced_at")
  complainedAt      DateTime?       @map("complained_at")
  unsubscribedAt    DateTime?       @map("unsubscribed_at")
  createdAt         DateTime        @default(now()) @map("created_at")

  clicks            NudgeClick[]

  @@unique([campaignId, userId]) // idempotent per user per campaign
  @@index([userId])
  @@index([status])
  @@map("nudge_sends")
}

// A click from the /go redirect or a provider click webhook.
model NudgeClick {
  id        Int       @id @default(autoincrement())
  sendId    String    @map("send_id")
  send      NudgeSend @relation(fields: [sendId], references: [id], onDelete: Cascade)
  jobId     Int?      @map("job_id")
  source    String    // redirect | webhook
  url       String?
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([sendId])
  @@index([jobId])
  @@map("nudge_clicks")
}

// Raw provider webhook events, keyed by the Svix message id for dedupe.
model EmailEvent {
  id              Int      @id @default(autoincrement())
  providerEventId String   @unique @map("provider_event_id")
  type            String
  messageId       String?  @map("message_id")
  payload         Json
  createdAt       DateTime @default(now()) @map("created_at")

  @@index([messageId])
  @@map("email_events")
}

// Small key/value store for operator switches (e.g. nudges.schedule_paused).
model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("app_settings")
}
